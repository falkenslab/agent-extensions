{
  "name": "calendar-extension",
  "private": true,
  "description": "Builds the calendar extension's MCP server into dist/server.mjs, and tests it: only for building it.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.mjs --bundle --minify --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "^0.28.2",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  }
}
