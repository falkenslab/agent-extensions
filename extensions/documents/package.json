{
  "name": "documents-extension",
  "private": true,
  "description": "Builds the documents extension's MCP server into dist/server.mjs, and tests it: only for building it.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.mjs --bundle --minify --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^18.2.0",
    "zod": "^4.6.7"
  }
}
