{
  "mcpServers": {
    "moodle": {
      "command": "npx",
      "args": [
        "-y",
        "@falkenslab/moodle-mcp@0.9.0"
      ],
      "env": {
        "MOODLE_MCP_SITES": "${user_config.sites}",
        "MOODLE_MCP_COURSES": "${user_config.courses}",
        "MOODLE_MCP_HEADLESS": "${user_config.headless}",
        "MOODLE_MCP_ROLE": "student",
        "MOODLE_MCP_ACCESS": "${user_config.access}",
        "MOODLE_MCP_STUDENT_DATA": "${user_config.student_data}",
        "MOODLE_MCP_CHANNEL": "${user_config.browser}",
        "MOODLE_MCP_SWITCH_AFTER_CRASHES": "${user_config.switch_after_crashes}"
      }
    }
  }
}
