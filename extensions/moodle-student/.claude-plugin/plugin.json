      "capabilities": [
        {
          "id": "lms-course-browsing",
          "skills": [
            "read-a-course"
          ],
          "tools": [
            "list_courses",
            "get_course_structure",
            "get_activity_content",
            "download_file",
            "get_course_updates",
            "list_notifications"
          ],
          "texts": {
            "en": {
              "label": "Reading a course",
              "description": "Sections, resources and activities, what's locked and why, and what counts as done."
            },
            "es": {
              "label": "Leer un curso",
              "description": "Secciones, recursos y actividades, qué está bloqueado y por qué, y qué cuenta como hecho."
            }
          }
        },
        {
          "id": "lms-planning",
          "skills": [
            "plan-my-work",
            "week"
          ],
          "tools": [
            "list_pending",
            "list_deadlines",
            "list_events",
            "get_activities_overview",
            "get_my_grades",
            "get_assignment",
            "get_quiz_info"
          ],
          "texts": {
            "en": {
              "label": "Planning your work",
              "description": "What's left, deadlines and cut-offs, and what unlocks what, in a realistic order."
            },
            "es": {
              "label": "Organizar tu trabajo",
              "description": "Lo que queda, las fechas de entrega y de corte, y qué desbloquea qué, en un orden realista."
            }
          }
        },
