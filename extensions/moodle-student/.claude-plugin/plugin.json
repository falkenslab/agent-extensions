{
  "name": "moodle-student",
  "version": "0.2.4",
  "description": "Work in your Moodle courses as a student, through moodle-mcp: what you have left and when, assignments, quizzes, forums and the other activities, your grades and feedback, with how to do each well in Moodle.",
  "author": {
    "name": "Falken's Lab",
    "url": "https://github.com/falkenslab"
  },
  "homepage": "https://github.com/falkenslab/agent-extensions/tree/main/extensions/moodle-student",
  "repository": "https://github.com/falkenslab/agent-extensions",
  "license": "MIT",
  "keywords": [
    "moodle",
    "lms",
    "learning",
    "student",
    "mcp",
    "padawan"
  ],
  "userConfig": {
    "sites": {
      "type": "string",
      "title": "Moodle sites",
      "description": "Your Moodle sites, each as name=address, e.g. school=https://campus.myschool.org. The first one is where the agent starts; you can add more later by asking it.",
      "multiple": true,
      "required": true
    },
    "courses": {
      "type": "string",
      "title": "Your courses (classrooms)",
      "description": "Only these courses, by their URLs (e.g. https://campus.myschool.org/course/view.php?id=12), comma-separated, on one site or several: the agent is refused any other. Empty: every course your account sees.",
      "default": ""
    },
    "headless": {
      "type": "boolean",
      "title": "Work without a browser window",
      "description": "The agent's browser works out of sight. A window opens anyway when you need to log in, or when you ask to watch.",
      "default": true
    },
    "access": {
      "type": "string",
      "title": "What the agent may do",
      "description": "write: hand in, answer and post for you (it asks before each). read: only look, never change.",
      "options": [
        "write",
        "read"
      ],
      "default": "write"
    },
    "student_data": {
      "type": "string",
      "title": "Other people's data",
      "description": "pseudonymize: classmates and teachers reach the agent as aliases, never by name. block: their data never reaches it. clear: with their names, only for an AI that runs on your own computer.",
      "options": [
        "pseudonymize",
        "block",
        "clear"
      ],
      "default": "pseudonymize"
    }
  },
  "metadata": {
    "agent-kit": {
      "kit": ">=0.22.0",
      "description": {
        "es": "Trabaja en tus cursos de Moodle como alumno, a través de moodle-mcp: lo que te queda y para cuándo, tareas, cuestionarios, foros y las demás actividades, tus notas y la retroalimentación, con cómo hacer bien cada cosa en Moodle."
      },
      "catalog": {
        "logo": "assets/logo.svg",
        "banner": "assets/banner.svg"
      },
      "provides": [
        "moodle",
        "moodle-student",
        "lms-student"
      ],
