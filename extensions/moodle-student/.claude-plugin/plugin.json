          "texts": {
            "en": {
              "label": "Reading a course",
              "description": "Sections, resources and activities, what's locked and why, and what counts as done."
            },
            "es": {
              "label": "Leer un curso",
              "description": "Secciones, recursos y actividades, qué está bloqueado y por qué, y qué cuenta como hecho."
            }
          }
        },
        {
          "id": "lms-planning",
          "skills": [
