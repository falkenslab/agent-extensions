{
  "mcpServers": {
    "video": {
      "command": "npx",
      "args": [
        "-y",
        "@falkenslab/video-mcp@0.1.0"
      ],
      "env": {
        "VIDEO_MCP_WORK_DIR": "${user_config.work_folder}",
        "VIDEO_MCP_WHISPER_MODEL": "${user_config.whisper_model}",
        "VIDEO_MCP_LANGUAGE": "${user_config.language}",
        "VIDEO_MCP_PYTHON": "${user_config.python}"
      }
    }
  }
}
