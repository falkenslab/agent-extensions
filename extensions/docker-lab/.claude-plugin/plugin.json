{
  "name": "docker-lab",
  "version": "0.1.1",
  "description": "Docker as a lab for your agent: it runs and tries software (tools, services, someone's code) in isolated containers without touching your computer, verifies that things work by running them, and manages your Docker, through docker-mcp, in the mode you choose (only read, only labs, or everything).",
  "author": {
    "name": "Falken's Lab",
    "url": "https://github.com/falkenslab"
  },
  "homepage": "https://github.com/falkenslab/agent-kit-extensions/tree/main/extensions/docker-lab",
  "repository": "https://github.com/falkenslab/agent-kit-extensions",
  "license": "MIT",
  "keywords": [
    "docker",
    "containers",
    "compose",
    "labs",
    "sandbox",
    "practices",
    "mcp",
    "miyagi",
    "padawan"
  ],
  "userConfig": {
    "mode": {
      "type": "string",
      "title": "What the agent may do",
      "description": "full: everything Docker does, asking before anything dangerous. lab: only labs, isolated under a safety policy. read: only look, never change.",
      "options": [
        "full",
        "lab",
        "read"
      ],
      "default": "full"
    },
    "scopes": {
      "type": "string",
      "title": "Areas",
      "description": "Only some areas, comma-separated: containers, images, volumes, networks, compose, system, labs. Empty: all of them.",
      "default": ""
    },
    "labs_dir": {
      "type": "string",
      "title": "Labs folder",
      "description": "Where the labs are: a folder per lab, with its compose.yaml. Empty: a labs folder in the extension's data folder.",
      "default": ""
    },
    "allow_internet": {
      "type": "boolean",
      "title": "Labs reach the internet",
      "description": "Labs' services reach the internet and publish ports to this computer. Off: they only reach each other.",
      "default": false
    },
    "cpus": {
      "type": "string",
      "title": "CPUs per lab service",
      "description": "The CPUs each service of a lab may use, e.g. 1 or 0.5.",
      "default": "1"
    },
    "memory": {
      "type": "string",
      "title": "Memory per lab service",
      "description": "The memory each service of a lab may use, e.g. 512m or 1g.",
      "default": "512m"
    },
    "allowed_images": {
      "type": "string",
      "title": "Images allowed in labs",
      "description": "Only these images in labs, comma-separated (e.g. nginx, postgres). Empty: any.",
      "default": ""
    }
  },
  "metadata": {
    "agent-kit": {
      "catalog": {
        "logo": "assets/logo.svg",
        "banner": "assets/banner.svg"
      },
      "kit": ">=0.23.0",
      "provides": [
        "docker-lab",
        "docker"
      ],
      "requires": [],
      "capabilities": [
        {
          "id": "docker-containers",
          "skills": [
            "use-docker"
          ],
          "tools": [
            "list_containers",
            "inspect_container",
            "container_logs",
            "container_stats",
            "container_processes",
            "run_container",
            "start_container",
            "stop_container",
            "restart_container",
            "remove_container",
            "exec_in_container",
            "copy_to_container",
            "copy_from_container"
          ],
          "texts": {
            "en": {
              "label": "Containers",
              "description": "Run, inspect, follow, measure and clean up containers, asking before anything dangerous."
            },
            "es": {
              "label": "Contenedores",
              "description": "Arrancar, inspeccionar, seguir, medir y limpiar contenedores, preguntando antes de lo peligroso."
            }
          }
        },
        {
          "id": "docker-images",
          "skills": [
