            "inspect_volume",
            "create_volume",
            "remove_volume",
            "list_networks",
            "inspect_network",
            "create_network",
            "remove_network"
          ],
          "texts": {
            "en": {
              "label": "Volumes, networks and clean-ups",
              "description": "Volumes and networks, Docker's disk usage, and cleaning up what isn't used."
            },
            "es": {
              "label": "Volúmenes, redes y limpieza",
              "description": "Volúmenes y redes, el disco que usa Docker y limpiar lo que no se usa."
            }
          }
        },
        {
          "id": "sandbox",
          "skills": [
            "try-in-a-lab",
            "build-a-lab"
          ],
          "tools": [
            "list_labs",
            "lab_status",
            "lab_logs",
            "lab_up",
            "lab_exec",
            "lab_reset",
            "lab_down"
          ],
          "texts": {
            "en": {
              "label": "Software lab",
              "description": "Run and try tools, services and someone's code in isolated labs, without installing anything on your computer: no internet, no host mounts, with limits."
            },
            "es": {
              "label": "Laboratorio de software",
              "description": "Ejecutar y probar herramientas, servicios y código ajeno en laboratorios aislados, sin instalar nada en tu ordenador: sin internet, sin montar el equipo, con límites."
            }
          }
        },
        {
          "id": "run-and-verify",
          "skills": [
            "verify-by-running"
          ],
          "tools": [
            "lab_up",
            "lab_exec",
            "lab_check",
            "lab_status",
            "lab_logs",
            "lab_reset"
          ],
          "texts": {
            "en": {
              "label": "Verifying by running",
              "description": "Whether code, instructions, a statement and its solution or a submission work, by running them in a lab, with a verdict and its evidence."
            },
            "es": {
              "label": "Verificar ejecutando",
              "description": "Si un código, unas instrucciones, un enunciado y su solución o una entrega funcionan, ejecutándolos en un laboratorio, con un veredicto y sus pruebas."
            }
          }
        }
      ],
      "requirements": [
        {
          "name": "Docker",
          "program": "docker",
          "version": {
            "args": [
              "--version"
            ],
            "min": "24.0.0"
          },
          "install": {
            "windows": "winget install Docker.DockerDesktop",
            "macos": "brew install --cask docker",
            "url": "https://docs.docker.com/get-started/get-docker/"
          }
        }
      ],
      "help": "Docker, through docker-mcp, in the mode chosen when it was installed (read, lab or full): isolated labs to run and try software without touching the computer, verifying by running, and managing containers, images, volumes, networks and Compose; my docker-lab:* skills say how.",
