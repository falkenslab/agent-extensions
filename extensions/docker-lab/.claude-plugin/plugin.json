            "build_image",
            "tag_image",
            "push_image",
            "remove_image"
          ],
          "texts": {
            "en": {
              "label": "Images",
              "description": "Pull, build, tag and push images, with your own registry login."
            },
            "es": {
              "label": "Imágenes",
              "description": "Descargar, construir, etiquetar y subir imágenes, con tu propio login en el registro."
            }
          }
        },
        {
          "id": "docker-compose",
          "skills": [
            "use-docker"
          ],
          "tools": [
            "compose_ps",
            "compose_logs",
            "compose_build",
            "compose_up",
            "compose_down",
            "compose_exec"
          ],
          "texts": {
            "en": {
              "label": "Compose projects",
              "description": "Build, start, follow and stop Compose projects."
            },
            "es": {
              "label": "Proyectos de Compose",
              "description": "Construir, arrancar, seguir y parar proyectos de Compose."
            }
          }
        },
        {
          "id": "docker-system",
          "skills": [
            "use-docker"
          ],
          "tools": [
            "docker_info",
