{
  "name": "moodle-teacher",
  "version": "0.2.7",
  "description": "Work in your Moodle courses as their teacher, through moodle-mcp: building them, grading, following the class, checking and reusing courses, with how to do each well in Moodle.",
  "author": {
    "name": "Falken's Lab",
    "url": "https://github.com/falkenslab"
  },
  "homepage": "https://github.com/falkenslab/agent-kit-extensions/tree/main/extensions/moodle-teacher",
  "repository": "https://github.com/falkenslab/agent-kit-extensions",
  "license": "MIT",
  "keywords": [
    "moodle",
    "lms",
    "teaching",
    "teacher",
    "mcp",
    "miyagi"
  ],
  "userConfig": {
    "sites": {
      "type": "string",
      "title": "Moodle sites",
      "description": "Your Moodle sites, each as name=address, e.g. school=https://campus.myschool.org. The first one is where the agent starts; you can add more later by asking it.",
      "multiple": true,
      "required": true
    },
    "headless": {
      "type": "boolean",
      "title": "Work without a browser window",
      "description": "The agent's browser works out of sight. A window opens anyway when you need to log in, or when you ask to watch.",
      "default": true
    },
    "access": {
      "type": "string",
      "title": "What the agent may do",
      "description": "write: read and change your courses (it asks before changing anything). read: only look, never change.",
      "options": [
        "write",
        "read"
      ],
      "default": "write"
    },
    "student_data": {
      "type": "string",
      "title": "Other people's data",
      "description": "pseudonymize: students reach the agent as aliases, never by name. block: their data never reaches it. clear: with their names, only for an AI that runs on your own computer.",
      "options": [
        "pseudonymize",
        "block",
        "clear"
      ],
      "default": "pseudonymize"
    }
  },
  "metadata": {
    "agent-kit": {
      "kit": ">=0.22.0",
      "description": {
        "es": "Trabaja en tus cursos de Moodle como docente, a través de moodle-mcp: construirlos, calificar, seguir a la clase, revisar y reutilizar cursos, con cómo hacer bien cada cosa en Moodle."
      },
      "catalog": {
        "logo": "assets/logo.svg",
        "banner": "assets/banner.svg"
      },
      "provides": [
        "moodle",
        "moodle-teacher",
        "lms-teacher"
      ],
      "requires": [],
      "capabilities": [
        {
          "id": "lms-course-reading",
          "skills": [
            "read-a-course"
          ],
          "tools": [
            "list_courses",
            "get_course_structure",
            "get_activity_settings",
            "get_activity_content",
            "get_me",
            "get_site_info",
            "get_course_updates",
            "get_activities_overview"
          ],
          "texts": {
            "en": {
              "label": "Reading a course",
              "description": "What you can do in a course, its sections, activities, restrictions, completion and dates, as Moodle has them now."
            },
            "es": {
              "label": "Leer un curso",
              "description": "Qué puedes hacer en un curso, sus secciones, actividades, restricciones, finalización y fechas, tal como están ahora en Moodle."
            }
          }
        },
        {
          "id": "lms-publishing",
          "skills": [
            "publishing"
          ],
          "tools": [
            "create_activity",
            "update_activity",
            "edit_activity",
            "add_section",
            "edit_section"
          ],
          "texts": {
            "en": {
              "label": "Publishing safely",
              "description": "New content goes up hidden, is checked, and is shown only with your yes; one approval per item."
            },
            "es": {
              "label": "Publicar con seguridad",
              "description": "Lo nuevo se sube oculto, se comprueba y solo se muestra con tu sí; una aprobación por cada cosa."
            }
          }
        },
        {
          "id": "lms-content",
          "skills": [
            "course-content"
          ],
          "tools": [
            "create_activity",
            "update_activity",
            "edit_activity",
            "add_section",
            "edit_section",
            "download_file"
          ],
          "texts": {
            "en": {
              "label": "Course content",
              "description": "Pages, books, files, folders, links and section texts, as HTML Moodle keeps."
            },
            "es": {
              "label": "Contenidos del curso",
              "description": "Páginas, libros, archivos, carpetas, enlaces y textos de sección, en un HTML que Moodle conserva."
            }
          }
        },
